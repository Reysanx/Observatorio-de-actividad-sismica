{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-report.schema.json",
  "title": "Seismic 6D Quality Report",
  "description": "Reproducible, population-scoped quality measurements. Proxies are not ground truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "generated_at_utc",
    "method_version",
    "rule_set_version",
    "populations",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "rule_set_version": {
      "type": "string",
      "minLength": 1
    },
    "populations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/population"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "source",
        "filters",
        "input_count",
        "input_identity",
        "transformations",
        "results"
      ],
      "properties": {
        "population_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "period_start_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "period_end_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "filters": {
          "type": "object"
        },
        "input_count": {
          "type": "integer",
          "minimum": 0
        },
        "after_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_identity": {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          },
          "additionalProperties": true
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "count",
              "definition"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "results": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "completeness"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "uniqueness"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "validity"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "consistency"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "currency"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "accuracy"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "metrics"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "completeness",
            "uniqueness",
            "validity",
            "consistency",
            "currency",
            "accuracy"
          ]
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "accuracy"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "then": {
            "properties": {
              "metrics": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/metric"
                    },
                    {
                      "$ref": "#/$defs/accuracyMetric"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "stage",
        "numerator",
        "denominator",
        "value",
        "unit",
        "formula",
        "evidence",
        "limitations"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "before",
            "after",
            "comparison",
            "not_verifiable"
          ]
        },
        "numerator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "denominator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_independent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "proxy": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "before",
                  "after",
                  "comparison"
                ]
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0
              },
              "denominator": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "not_verifiable"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "numerator": {
                "type": "null"
              },
              "denominator": {
                "type": "null"
              },
              "value": {
                "type": "null"
              },
              "unit": {
                "type": "null"
              },
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "accuracyMetric": {
      "type": "object",
      "required": [
        "reference_independent",
        "proxy"
      ],
      "properties": {
        "reference_independent": {
          "const": false
        },
        "proxy": {
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "before",
            "after",
            "comparison",
            "not_verifiable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "before",
                  "after",
                  "comparison"
                ]
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "proxy": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformation_id",
        "stage",
        "status",
        "affected_count",
        "denominator",
        "overlap_policy",
        "definition",
        "evidence",
        "limitations"
      ],
      "properties": {
        "transformation_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "measured",
            "not_verifiable"
          ]
        },
        "affected_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "denominator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "overlap_policy": {
          "enum": [
            "mutually_exclusive",
            "may_overlap",
            "not_applicable"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "measured"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "affected_count": {
                "type": "integer"
              },
              "denominator": {
                "type": "integer"
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_verifiable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "affected_count": {
                "type": "null"
              },
              "denominator": {
                "type": "null"
              },
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
